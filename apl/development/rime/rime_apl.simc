
actions.precombat=snapshot_stats
actions.precombat+=/frost_bolt

# actions+=/run_action_list,name=basics,if=legendary.frostwyrms_spite&blessing.the_vehement
actions+=/run_action_list,name=main

actions.variables=variable,name=will_spend_orbs,value=active_enemies>=3|talent.icy_talons|(action.frost_bolt.execute_time<=1.16|!talent.cascading_blitz|talent.bursting_swallows&talent.burstbolter&action.frost_bolt.execute_time<=1.25|talent.icy_flow&talent.burstbolter&talent.bursting_swallows&!talent.greater_glacial_blast&action.frost_bolt.execute_time<=1.36|!buff.ice_blitz.up),op=set

actions.main=flight_of_the_navir,if=(target.time_to_die>=18|fight_remains<=20)
actions.main+=/icicles_of_anzhyr,if=!raid_event.adds.exists|active_enemies%2>=raid_event.adds.count|raid_event.adds.in>=12
actions.main+=/wrath_of_winter,if=(target.time_to_die>=28|fight_remains<=20|spirit.deficit<=10)&((!weapon.voidbringer|cooldown.voidbringers_touch.remains>45|spirit.deficit<=10)|!weapon_trait.visions_of_grandeur)&(buff.ice_blitz.up|spirit.deficit<=10)
actions.main+=/winters_blessing,if=(target.time_to_die>=20|fight_remains<=20)&(worb>=2&!talent.icy_talons|worb>=4&talent.icy_talons)
actions.main+=/voidbringers_touch,if=!debuff.voidbringer_accumulator.up
actions.main+=/bursting_ice,if=worb>=4|refreshable|target.time_to_die<=5
actions.main+=/ice_blitz,if=(!talent.cascading_blitz&target.time_to_die>=18|target.time_to_die>=25|fight_remains<=60)&!buff.ice_blitz.up|!buff.the_philosopher.up&buff.winters_embrace.up
actions.main+=/talon_strike,if=buff.glacial_assault.at_max_stacks
actions.main+=/glacial_blast,if=buff.glacial_assault.at_max_stacks
actions.main+=/rising_talons,if=buff.winters_embrace.up&worb>=4&active_enemies>=(3+talent.greater_glacial_blast)
actions.main+=/talon_strike,if=buff.winters_embrace.up&worb>=4&active_enemies<(3+talent.greater_glacial_blast)
actions.main+=/rising_talons,if=worb>=5&(cooldown.bursting_ice.remains>=3|buff.wrath_of_winter.up)&active_enemies>=(3+talent.greater_glacial_blast)
actions.main+=/talon_strike,if=worb>=5&(cooldown.bursting_ice.remains>=3|buff.wrath_of_winter.up)&active_enemies<(3+talent.greater_glacial_blast)
actions.main+=/ice_comet,if=active_enemies>=2&(worb>=5&!talent.cascading_blitz|buff.undulating_spirit.react|buff.winters_embrace.up)
actions.main+=/cold_snap,if=(worb<5|charges_fractional>=1.0|buff.navirs_keeper.up)&!buff.glacial_assault.at_max_stacks
actions.main+=/freezing_torrent,if=worb<=2&cooldown.cold_snap.charges=0&cooldown.bursting_ice.remains>=2&target.time_to_die>=5
actions.main+=/glacial_blast,if=active_enemies=1&(worb>=4&variable.will_spend_orbs|buff.undulating_spirit.react|buff.winters_embrace.up|buff.icy_flow.at_max_stacks|buff.icy_flow.up&(talent.supreme_torrent|talent.soulfrost_torrent))&(!talent.harrowing_ice|!talent.cascading_blitz|!talent.burstbolter|!buff.ice_blitz.up|action.frost_bolt.execute_time<=1.16|buff.wrath_of_winter.up|buff.icy_flow.up)
actions.main+=/chronoshift,if=active_enemies>=3|target.time_to_die>=15
actions.main+=/natures_fury
actions.main+=/cold_snap,if=buff.the_vehement.at_max_stacks
actions.main+=/frost_bolt